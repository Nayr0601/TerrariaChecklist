{
  "name": "journey-ledger",
  "private": true,
  "version": "1.0.0",
  "description": "A client-side Terraria Journey Mode research tracker and progression checklist.",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:items",
    "dev": "vite",
    "prebuild": "npm run generate:items",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "npm run generate:items && npm run generate:fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "generate:items": "tsx scripts/generate-items.ts",
    "generate:fixtures": "tsx tests/fixtures/generate-fixtures.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
